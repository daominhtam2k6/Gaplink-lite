# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
.venv*/

# Data and experiment outputs (regenerated locally; see README)
data/
runs/*
*.npy
*.pkl
*.log

# Large binaries: only the two frozen checkpoints are force-added
release/*.pt
*.mp4
!demo/showcase/*.mp4

# Generated figures and outputs (the report uses report/latex/figures)
report/figures/
report/failure_cases/

# Demo outputs and scratch clips
demo/out/

# Local working notes (not part of the published project)
docs/internal/

# LaTeX build files
report/latex/*.aux
report/latex/*.bbl
report/latex/*.bcf
report/latex/*.blg
report/latex/*.lof
report/latex/*.lot
report/latex/*.out
report/latex/*.run.xml
report/latex/*.toc
report/latex/*.log
report/latex/*.synctex.gz

# user videos for the console (raw uploads and prepared clips)
demo/uploads/*
!demo/uploads/.gitkeep
demo/live_videos/
